{
  "name": "andromeda-desktop",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "format:check": "prettier --check src scripts index.html package.json vite.config.ts",
    "installer": "node scripts/build-installer.mjs",
    "install:macos": "python3 ../scripts/install-macos.py --app ../target/release/bundle/macos/Andromeda.app",
    "test:packaging": "node --test scripts/stage-executable.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
